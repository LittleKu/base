import("../base.gni")

config("example_config") {
  if (is_win) {
    ldflags = [ "/SUBSYSTEM:WINDOWS" ]
  }
}

base_executable("example") {
  configs += [ ":example_config" ]

  include_dirs = [ "../" ]

  sources = [ "example.cc" ]

  deps = [ "//base" ]

  if (is_win) {
    deps += [ "//third_party/wtl" ]
  }

  suppressed_configs = [ "//build/config/compiler:thin_archive" ]
}

base_executable("base_smoke_test") {
  testonly = true
  sources = [ "base_smoke_test.cc" ]
  deps = [
    "//base",
    "//base/version_info",
  ]
}
